{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "Bash(godot *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push -u origin task/*)",
      "Bash(git push origin task/*)",
      "Bash(git push -u origin setup/*)",
      "Bash(git push origin setup/*)",
      "Skill(ship-task)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh label list *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "PowerShell",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/process/**)",
      "Edit(/global.json)",
      "Edit(/.gitignore)",
      "Edit(/.gitattributes)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh ruleset *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(git config --global *)",
      "Bash(claude *)",
      "mcp__claude-in-chrome__*",
      "mcp__Claude_Browser__*",
      "mcp__computer-use__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/studio-hook.sh\" session-context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/studio-hook.sh\" bash-guard"
          }
        ]
      }
    ]
  }
}
